    },
    {
      "parameters": {
        "jsCode": "// Lista los contratos de Awayu publicados en testnet.json\nconst t = $input.first().json;\nconst ids = new Map();\n(t.circulos || []).forEach((c) => ids.set(c, 'pasanaku'));\nif (t.contractId) ids.set(t.contractId, 'pasanaku');\nif (t.registro) ids.set(t.registro, 'registro');\nfor (const k of ['ayni', 'minka', 'alasitas']) if (t[k] && t[k].contractId) ids.set(t[k].contractId, k);\nreturn [...ids].map(([id, tipo]) => ({ json: { id, tipo } }));\n"
      },
      "id": "dde4621b-5500-544e-a101-b21234dd244d",
      "name": "Contratos de Awayu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.stellar.expert/explorer/testnet/contract/{{ $json.id }}",
        "options": {
          "timeout": 15000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 500
            }
          }
        }
      },
      "id": "5c3f6963-ba78-5bc0-971a-8eb551df192d",
      "name": "Actividad en Stellar Expert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const AVISOS = 'awayu-avisos-j614insb'; // el mismo tema del flujo 01\nconst WEB = 'https://awayu-two.vercel.app';\nconst filas = $input.all().map((i) => i.json);\nconst contratos = $('Contratos de Awayu').all().map((i) => i.json);\nlet invocaciones = 0, eventos = 0, errores = 0, respondieron = 0;\nfor (const f of filas) {\n  if (typeof f.invocations === 'number') { respondieron++; invocaciones += f.invocations; eventos += f.events || 0; errores += f.errors || 0; }\n}\nconst porTipo = contratos.reduce((a, c) => ((a[c.tipo] = (a[c.tipo] || 0) + 1), a), {});\nconst detalle = Object.entries(porTipo).map(([k, n]) => n + ' ' + k).join(', ');\nconst message = contratos.length + ' contratos (' + detalle + '). Invocaciones: ' + invocaciones + ', eventos: ' + eventos + ', errores: ' + errores + '. Datos de Stellar Expert (' + respondieron + ' de ' + contratos.length + ' contratos respondieron).';\nreturn [{ json: { topic: AVISOS, title: 'Resumen semanal de Awayu en Stellar', message, tags: ['bar_chart'], click: WEB } }];\n"
      },
      "id": "3c34d61d-16f0-5423-be7e-853ed8341af5",
      "name": "Armar resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
