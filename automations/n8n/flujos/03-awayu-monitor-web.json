    {
      "parameters": {
        "jsCode": "const AVISOS = 'awayu-avisos-j614insb'; // el mismo tema del flujo 01\nconst WEB = 'https://awayu-two.vercel.app';\nconst estadoDe = (nombre, esperado) => {\n  try { return $(nombre).first().json.statusCode === esperado; } catch (e) { return false; }\n};\nconst revisiones = {\n  'Página principal': estadoDe('Página principal', 200),\n  'Datos de testnet': estadoDe('Datos de testnet', 200),\n  'Servidor de eventos': estadoDe('Servidor de eventos', 202),\n};\nconst caidos = Object.entries(revisiones).filter(([, ok]) => !ok).map(([k]) => k);\n// Solo avisa cuando el estado cambia (para no repetir el mismo aviso cada 30 minutos)\nconst memoria = $getWorkflowStaticData('global');\nconst antes = (memoria.caidos || []).join('|');\nmemoria.caidos = caidos;\nmemoria.revisado = new Date().toISOString();\nif (caidos.join('|') === antes) return [];\nif (caidos.length) return [{ json: { topic: AVISOS, title: 'Awayu tiene un problema', message: 'No responde: ' + caidos.join(', ') + '.', tags: ['rotating_light'], priority: 5, click: WEB } }];\nreturn [{ json: { topic: AVISOS, title: 'Awayu funciona de nuevo', message: 'La página, los datos de testnet y el servidor de eventos responden.', tags: ['white_check_mark'], click: WEB } }];\n"
      },
      "id": "0696f3b1-1f46-52ce-8d93-e346844a2c7b",
      "name": "Comparar con la revisión anterior",
      "type": "n8n-nodes-base.code",
